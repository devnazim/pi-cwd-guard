{
  "name": "pi-cwd-guard",
  "version": "0.5.0",
  "description": "Small Pi safety extension for cwd access, protected paths, runtime config confirmation, and common destructive bash commands.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cwd",
    "guard",
    "safety"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devnazim/pi-cwd-guard.git"
  },
  "bugs": {
    "url": "https://github.com/devnazim/pi-cwd-guard/issues"
  },
  "homepage": "https://github.com/devnazim/pi-cwd-guard#readme",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "typescript": "^6.0.3"
  }
}
